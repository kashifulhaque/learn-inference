# ---------------------------------------------------------------------------
# learn-inference — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Auth -------------------------------------------------------------------
# Shared secret configured in Caddy's trusted SSO header forwarding.
SSO_PROXY_SECRET=change-me-to-a-long-random-string
# Optional username-to-existing-data-name mapping, comma-separated.
SSO_USERS=

# --- App --------------------------------------------------------------------
# Directory for the SQLite database. Mounted as a volume in docker-compose.
DATA_DIR=/data
# Public base URL, used only for display.
PUBLIC_URL=https://qwen.ifkash.dev

# --- GPU providers ----------------------------------------------------------
# The provider labs run on. RunPod is the only one.
GPU_PROVIDER=runpod
# The accelerator the labs ask for, shown in the header. The 27B model in bf16
# needs ~54 GB, so A100-80GB.
GPU_TYPE=A100-80GB

# RunPod (https://runpod.io).
RUNPOD_API_KEY=
# Serverless endpoint id running the worker in gpu/runpod_worker/.
RUNPOD_ENDPOINT_ID=

# --- Model ------------------------------------------------------------------
# Hugging Face token, needed to download weights.
HF_TOKEN=
# The model the curriculum targets.
MODEL_ID=Qwen/Qwen3.8-27B
# A small model used for fast local iteration in early chapters.
SMALL_MODEL_ID=Qwen/Qwen3-0.6B
