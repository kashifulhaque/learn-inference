# ---------------------------------------------------------------------------
# learn-inference — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Auth -------------------------------------------------------------------
# Shared password for the two people who use this app.
APP_PASSWORD=mochimochi
# Random string used to sign session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string
# How long a login lasts, in days.
SESSION_DAYS=30
# Set to 1 when serving over HTTPS so cookies get the Secure flag.
COOKIE_SECURE=1

# --- App --------------------------------------------------------------------
# Directory for the SQLite database. Mounted as a volume in docker-compose.
DATA_DIR=/data
# Public base URL, used only for display.
PUBLIC_URL=https://qwen.ifkash.dev

# --- GPU providers ----------------------------------------------------------
# Which provider to use first. "runpod" is the default; "modal" is the
# alternative, and the lab pane can switch a single run either way.
GPU_PROVIDER=runpod
# The accelerator the labs ask for, shown in the header. The 27B model in bf16
# needs ~54 GB, so A100-80GB.
GPU_TYPE=A100-80GB

# RunPod (https://runpod.io) — the default provider.
RUNPOD_API_KEY=
# Serverless endpoint id running the worker in gpu/runpod_worker/.
RUNPOD_ENDPOINT_ID=

# Modal (https://modal.com) — the alternative. Create tokens with
# `modal token new`.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Name the Modal app was deployed under (`modal deploy gpu/modal_app.py`).
MODAL_APP_NAME=learn-inference
# GPU to request, in Modal's spelling.
MODAL_GPU=A100-80GB

# --- Model ------------------------------------------------------------------
# Hugging Face token, needed to download weights.
HF_TOKEN=
# The model the curriculum targets.
MODEL_ID=Qwen/Qwen3.8-27B
# A small model used for fast local iteration in early chapters.
SMALL_MODEL_ID=Qwen/Qwen3-0.6B
